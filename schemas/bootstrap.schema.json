{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idobata.s21g.com/schemas/bootstrap.schema.json",
  "title": "idobata v1 初期ノード広告",
  "type": "object",
  "additionalProperties": false,
  "required": ["signed", "key_id", "signature"],
  "properties": {
    "key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "issued_at", "expires_at", "peers"],
      "properties": {
        "version": {"const": 1},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "issued_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "expires_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "peers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["peer_id", "addresses", "roles", "advertised_at", "expires_at", "signature"],
            "properties": {
              "peer_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "addresses": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
              "roles": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["bootstrap", "relay"]}},
              "advertised_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "expires_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
            }
          }
        }
      }
    }
  },
  "$comment": "外側署名と各peer広告の署名を両方検証する。peer IDの重複、期限の大小、公開アドレス区分、認可、到達性は別途検証する。"
}
